<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ManifestUpdater.ico</ApplicationIcon>
    <AssemblyName>WingetManifestStudio</AssemblyName>
    <Product>Winget Manifest Studio</Product>
    <Title>Winget Manifest Studio</Title>
    <Description>Create, update, inspect, validate, and submit Windows Package Manager manifests.</Description>
    <Company>ubidzz</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
