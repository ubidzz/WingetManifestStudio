<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>ManifestUpdater.ico</ApplicationIcon>
    <AssemblyName>WingetManifestStudio</AssemblyName>
    <Product>Winget Manifest Studio</Product>
    <Title>Winget Manifest Studio</Title>
    <Description>Create, update, inspect, validate, and submit Windows Package Manager manifests.</Description>
    <Company>ubidzz</Company>
    <Version>1.0.0</Version>
    <FileVersion>$(Version).0</FileVersion>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
  </PropertyGroup>

  <Target Name="BuildMsiAfterPublish"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(PublishProtocol)' != 'ClickOnce'">
    <PropertyGroup>
      <_StudioPublishDirectory>$([System.IO.Path]::GetFullPath('$(PublishDir)'))</_StudioPublishDirectory>
      <_StudioPublishPathMarker>$([System.IO.Path]::Combine('$(_StudioPublishDirectory)', '_'))</_StudioPublishPathMarker>
      <_StudioPublishDirectory>$([System.IO.Path]::GetDirectoryName('$(_StudioPublishPathMarker)'))</_StudioPublishDirectory>
      <_StudioPublishedExe>$([System.IO.Path]::Combine('$(_StudioPublishDirectory)', '$(AssemblyName).exe'))</_StudioPublishedExe>
      <_StudioMsiProject>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Packaging', 'MSI', 'WingetManifestStudioInstaller.wixproj'))</_StudioMsiProject>
      <_StudioMsiBuildOutput>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Packaging', 'MSI', 'bin', 'Release', 'SynixStudioSetup.msi'))</_StudioMsiBuildOutput>
      <_StudioMsiOutput>$([System.IO.Path]::Combine('$(_StudioPublishDirectory)', 'SynixStudioSetup.msi'))</_StudioMsiOutput>
      <_StudioDotNetHost Condition="'$(DotNetHostPath)' != ''">$(DotNetHostPath)</_StudioDotNetHost>
      <_StudioDotNetHost Condition="'$(_StudioDotNetHost)' == '' and '$(ProgramW6432)' != ''">$([System.IO.Path]::Combine('$(ProgramW6432)', 'dotnet', 'dotnet.exe'))</_StudioDotNetHost>
      <_StudioDotNetHost Condition="'$(_StudioDotNetHost)' == ''">$([System.IO.Path]::Combine('$(ProgramFiles)', 'dotnet', 'dotnet.exe'))</_StudioDotNetHost>
    </PropertyGroup>

    <Error Condition="!Exists('$(_StudioPublishedExe)')" Text="The published Winget Manifest Studio executable was not found at $(_StudioPublishedExe)." />
    <Error Condition="!Exists('$(_StudioMsiProject)')" Text="The Winget Manifest Studio MSI project was not found at $(_StudioMsiProject)." />
    <Error Condition="!Exists('$(_StudioDotNetHost)')" Text="The 64-bit .NET host was not found at $(_StudioDotNetHost). Repair the Visual Studio .NET SDK before publishing." />

    <Message Text="Building SynixStudioSetup.msi with Version $(Version)..." Importance="high" />
    <Exec
      Command="&quot;$(_StudioDotNetHost)&quot; build &quot;$(_StudioMsiProject)&quot; --configuration Release --nologo &quot;-p:Version=$(Version)&quot; &quot;-p:StudioPublishDir=$(_StudioPublishDirectory)&quot; &quot;-p:StudioProjectDir=$(MSBuildProjectDirectory)&quot; &quot;-p:StudioAssemblyName=$(AssemblyName)&quot;"
      WorkingDirectory="$(MSBuildProjectDirectory)" />

    <Error Condition="!Exists('$(_StudioMsiBuildOutput)')" Text="WiX did not create $(_StudioMsiBuildOutput)." />
    <Delete Files="$(_StudioMsiOutput)" Condition="Exists('$(_StudioMsiOutput)')" />
    <Copy SourceFiles="$(_StudioMsiBuildOutput)" DestinationFiles="$(_StudioMsiOutput)" />
    <Error Condition="!Exists('$(_StudioMsiOutput)')" Text="The MSI was not copied to $(_StudioMsiOutput)." />
    <Message Text="Winget Manifest Studio MSI created at $(_StudioMsiOutput)." Importance="high" />
  </Target>

</Project>
